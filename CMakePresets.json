{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless (no UI, container-friendly)",
      "inherits": "base",
      "cacheVariables": {
        "AESTRA_HEADLESS_ONLY": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI headless deterministic tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AESTRA_CI": "ON"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI sanitizer headless tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AESTRA_CI": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-tsan",
      "displayName": "CI ThreadSanitizer headless tests (advisory)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AESTRA_CI": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "full",
      "displayName": "Full app (UI + tests default)",
      "inherits": "base",
      "cacheVariables": {
        "AESTRA_HEADLESS_ONLY": "OFF"
      }
    },
    {
      "name": "full-fast",
      "displayName": "Full app (UI, tests OFF for faster/confident builds)",
      "inherits": "base",
      "cacheVariables": {
        "AESTRA_HEADLESS_ONLY": "OFF",
        "AESTRA_ENABLE_TESTS": "OFF"
      }
    },
    {
      "name": "lowmem",
      "displayName": "Low-memory build (4GB RAM laptop)",
      "inherits": "base",
      "cacheVariables": {
        "AESTRA_HEADLESS_ONLY": "OFF",
        "AESTRA_ENABLE_TESTS": "OFF",
        "AESTRA_LOW_MEMORY_BUILD": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "ci-lsan",
      "displayName": "CI LeakSanitizer headless tests (advisory)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AESTRA_CI": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=leak -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=leak",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=leak"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless-release",
      "displayName": "Build AestraHeadless (Release)",
      "configurePreset": "headless",
      "configuration": "Release",
      "targets": [
        "AestraHeadless"
      ],
      "jobs": 0
    },
    {
      "name": "headless-debug",
      "displayName": "Build AestraHeadless (Debug)",
      "configurePreset": "headless",
      "configuration": "Debug",
      "targets": [
        "AestraHeadless"
      ],
      "jobs": 0
    },
    {
      "name": "ci-release",
      "displayName": "Build CI deterministic tests (Release)",
      "configurePreset": "ci",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "ci-asan",
      "displayName": "Build CI sanitizer tests",
      "configurePreset": "ci-asan",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "ci-tsan",
      "displayName": "Build CI ThreadSanitizer tests",
      "configurePreset": "ci-tsan",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "ci-lsan",
      "displayName": "Build CI LeakSanitizer tests",
      "configurePreset": "ci-lsan",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "full-release",
      "displayName": "Build full solution (Release)",
      "configurePreset": "full",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "full-fast-release",
      "displayName": "Build full app fast (Release)",
      "configurePreset": "full-fast",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "lowmem-release",
      "displayName": "Build low-mem (Release, 2 jobs)",
      "configurePreset": "lowmem",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "lowmem",
      "displayName": "Build low-mem (Release)",
      "configurePreset": "lowmem",
      "configuration": "Release"
    }
  ]
}
