{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command History Eval Result",
  "type": "object",
  "required": ["run_id", "timestamp", "git", "lanes", "decision"],
  "properties": {
    "run_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": { "type": "string" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "lanes": {
      "type": "object",
      "required": ["command_history", "macro_command", "move_clip_command", "clip_commands", "mixer_commands", "command_transaction"],
      "properties": {
        "command_history": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } },
        "macro_command": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } },
        "move_clip_command": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } },
        "clip_commands": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } },
        "mixer_commands": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } },
        "command_transaction": { "type": "object", "required": ["binary", "exit_code", "output_file"], "properties": { "binary": { "type": "string" }, "exit_code": { "type": "integer" }, "output_file": { "type": "string" } } }
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["accept", "reject", "inconclusive"] },
        "reason": { "type": "string" },
        "hard_gate_failures": { "type": "array", "items": { "type": "string" } },
        "advisory_flags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
